<div class="progress" aria-hidden="true"><i></i></div>

<style>
  .progress {
    position: fixed;
    z-index: 60;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: rgba(255, 91, 58, 0.15);
    pointer-events: none;
  }
  .progress i {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--accent);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('.progress i');
  const target = document.querySelector<HTMLElement>('[data-progress-target]');
  if (bar && target) {
    let queued = false;
    const update = () => {
      queued = false;
      const r = target.getBoundingClientRect();
      const total = r.height - window.innerHeight * 0.6;
      const done = Math.min(1, Math.max(0, (window.innerHeight * 0.4 - r.top) / Math.max(1, total)));
      bar.style.transform = `scaleX(${done})`;
    };
    const onScroll = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>
