---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  kicker: string;
  title: string;
  dek?: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  /** Language of the title/dek text (differs from the page locale on fallback). */
  lang?: string;
}
const { kicker, title, dek, cover, coverAlt = '', lang } = Astro.props;
---

{
  cover ? (
    <header class="head film">
      <Image class="bg" src={cover} alt={coverAlt} widths={[800, 1400, 2000]} sizes="100vw" format="webp" loading="eager" fetchpriority="high" />
      <div class="grain" aria-hidden="true" />
      <div class="in" lang={lang}>
        <p class="kick">{kicker}</p>
        <h1>{title}</h1>
        {dek && <p class="dek">{dek}</p>}
      </div>
    </header>
  ) : (
    <header class="head plain">
      <div class="in" lang={lang}>
        <p class="kick">{kicker}</p>
        <h1>{title}</h1>
        {dek && <p class="dek">{dek}</p>}
      </div>
    </header>
  )
}

<style>
  .head {
    position: relative;
  }
  .in {
    position: relative;
    z-index: 3;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 var(--gutter);
    padding-left: calc(var(--gutter) + 214px);
  }
  .plain {
    padding: 64px 0 44px;
    border-bottom: 1px solid var(--rule);
  }
  .film {
    min-height: clamp(380px, 56vh, 540px);
    display: flex;
    align-items: flex-end;
    padding: 120px 0 48px;
    overflow: hidden;
    background: var(--cover-bg);
    color: var(--cover-ink);
  }
  .film :global(.bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    filter: brightness(0.45) saturate(0.75) blur(2px);
    animation: kb 22s ease-in-out infinite alternate;
  }
  .film::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(19, 17, 15, 0.82) 0, rgba(19, 17, 15, 0.3) 32%, rgba(19, 17, 15, 0.45) 62%, #13110f 100%);
  }
  .film .grain {
    z-index: 2;
    animation: none;
  }
  @keyframes kb {
    from { transform: scale(1.06); }
    to { transform: scale(1.14) translate(-2%, -2%); }
  }
  .kick {
    margin: 0 0 14px;
    font-family: var(--f-sans);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--link);
  }
  .film .kick {
    color: var(--accent);
  }
  .film :global(:focus-visible) {
    outline-color: var(--accent);
  }
  h1 {
    margin: 0;
    max-width: 820px;
    font-family: var(--f-serif);
    font-weight: 700;
    font-size: clamp(34px, 5vw, 54px);
    line-height: 1.2;
    letter-spacing: 0.01em;
    text-wrap: balance;
  }
  .film h1 {
    color: #f6f1e9;
  }
  .dek {
    margin: 16px 0 0;
    max-width: 680px;
    font-family: var(--f-serif);
    font-size: clamp(17px, 1.6vw, 19px);
    line-height: 1.7;
    color: var(--ink-2);
  }
  .film .dek {
    color: rgba(233, 227, 217, 0.75);
  }
  @media (max-width: 900px) {
    .in {
      padding-left: var(--gutter);
    }
    .plain {
      padding: 44px 0 32px;
    }
  }
</style>
